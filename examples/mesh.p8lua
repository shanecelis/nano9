--[===[
template = "pico8"
[[mesh]]
cuboid = [0.3, 0.3, 0.3]
[[mesh]]
path = "utah-teapot-lifesize.glb"
]===]
function _init()
    cls()
    print("hello")
    camera3d(0,0,-5, 0,0,0)
    square = mesh(0, 0,1,0, 1,1,1)

    teapot = mesh(1, 0,0,0, 1,1,1)
end

t = 0
function _update()
    teapot:rot(t/60)
    t = t + 1
end
