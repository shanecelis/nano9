--[===[
template = "pico8"
[defaults]
initial_palette = 1
time_to_live = 0
[[sprite_sheet]]
path = "bird-sprite-indexed.png"
index_color = true
sprite_size = [16, 16]
[[palette]]
path = "bird-sprite-indexed.png"
extract_index = true
[[palette]]
path = "red-palette.png"
extract_index = false
]===]

t = 0
p = 0

function _init()
end

function _draw()
    cls()
    local n = time() * 4 % 8 + 8
    local x, y = t % 128, t / 128
    local flip_horizontal = true
    spr(n, x, y, 1, 1, flip_horizontal)
    t = t + 1
end

function _update()
    if btnp() then
        p += 1 -- Cycle through the palettes.
        palm(p)
    end
end
