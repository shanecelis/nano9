--[===[
template = "pico8"
[defaults]
palette_index = 1
[[sprite_sheet]]
path = "bird-sprite-indexed.png"
index_color = true
extract_palette = true
sprite_size = [16, 16]
[[palette]]
path = "bird-sprite-palette.png"
]===]

function _init()
    -- Replace a blue with black.
    pal(6, 1)
end
t = 0
function _draw()
    cls()
    local n = time() * 4 % 8 + 8
    local x, y = t % 128, t / 128
    spr(n, x, y, 1, 1, true --[[flip horizontal]])
    t = t + 1
end
