#!/usr/bin/env bash
# Run one Pico-8 cart and write its screenshot or audio capture to -o.
# Requires a Pico-8 binary. Default: `p8` on PATH (e.g. $HOME/bin/p8).
#
#   bin/golden-pico8 tests/golden/line.p8 -o tests/golden/line-expected.png
#   bin/golden-pico8 tests/golden/sfx/sfx-loop.p8 -o tests/golden/sfx/sfx-loop-expected.wav
#
# PNG goldens use `pico8 -x` (headless). Playback WAV goldens use `pico8 -run`
# with `extcmd("audio_rec")` / `audio_end` because `-x` does not mix audio.
# Synth-shape goldens (waveforms, effects) use `bin/golden-synth` instead:
# headless `-export *.wav` writes silence, so that path is interactive.
# `-home` is a temp dir so config.txt is not overwritten.
set -euo pipefail

usage() {
  echo "usage: $0 CART -o OUTPUT.png|OUTPUT.wav" >&2
  exit 2
}

# Follow symlinks so pico8.dat is found next to the real binary
# ($HOME/bin/p8 -> PICO-8.app/Contents/MacOS/pico8).
resolve_exe() {
  local cmd="$1" path
  if [[ "$cmd" == */* ]]; then
    path="$cmd"
  else
    path="$(command -v "$cmd")" || return 1
  fi
  [[ -e "$path" ]] || return 1
  while [[ -L "$path" ]]; do
    local link dir
    link="$(readlink "$path")"
    dir="$(cd "$(dirname "$path")" && pwd -P)"
    if [[ "$link" == /* ]]; then
      path="$link"
    else
      path="$dir/$link"
    fi
  done
  echo "$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")"
}

cart=""
output=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o)
      [[ $# -ge 2 ]] || usage
      output="$2"
      shift 2
      ;;
    -h | --help)
      usage
      ;;
    -*)
      echo "error: unknown option $1" >&2
      usage
      ;;
    *)
      [[ -z "$cart" ]] || usage
      cart="$1"
      shift
      ;;
  esac
done

[[ -n "$cart" && -n "$output" ]] || usage
[[ -f "$cart" ]] || {
  echo "error: cart not found: $cart" >&2
  exit 1
}

PICO8_CMD="${PICO8:-p8}"
if ! PICO8_BIN="$(resolve_exe "$PICO8_CMD")"; then
  echo "error: Pico-8 binary not found ($PICO8_CMD). Set PICO8 or put p8 on PATH." >&2
  exit 1
fi

# If `p8` is a wrapper, still run the real binary so -home/-desktop apply
# to Pico-8 itself. resolve_exe already followed the wrapper's destination
# when it is a symlink; a script named p8 is resolved as itself, so fall
# back to the Mac app when that happens.
if [[ "$PICO8_BIN" == *"/p8" ]] && [[ -x /Applications/PICO-8.app/Contents/MacOS/pico8 ]]; then
  PICO8_BIN="/Applications/PICO-8.app/Contents/MacOS/pico8"
fi

name="$(basename "$cart")"
name="${name%.p8}"
name="${name%.P8}"
cart="$(cd "$(dirname "$cart")" && pwd -P)/$(basename "$cart")"
ext="${output##*.}"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo "using $PICO8_BIN"

find_output() {
  local needle="$1"
  if [[ -f "$tmp/$needle" ]]; then
    echo "$tmp/$needle"
    return 0
  fi
  shopt -s nullglob
  local files=("$tmp"/*."$ext")
  shopt -u nullglob
  if [[ ${#files[@]} -eq 1 ]]; then
    echo "${files[0]}"
    return 0
  fi
  return 1
}

if [[ "$ext" == "wav" ]]; then
  # `-x` writes a header-only wav. `-export` writes silence. `-run` mixes.
  "$PICO8_BIN" -run "$cart" -p headless -windowed 1 -volume 256 \
    -home "$tmp" -root_path "$tmp" -desktop "$tmp" &
  pid=$!
  src=""
  for _ in $(seq 1 80); do
    if src="$(find_output "${name}.wav")" && [[ "$(wc -c < "$src")" -gt 44 ]]; then
      sleep 0.4
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.25
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  if [[ -z "$src" ]]; then
    src="$(find_output "${name}.wav" || true)"
  fi
else
  "$PICO8_BIN" -x "$cart" -p headless -screenshot_scale 1 -root_path "$tmp" -windowed 1
  src=""
  if [[ -f "$tmp/${name}.png" ]]; then
    src="$tmp/${name}.png"
  else
    shopt -s nullglob
    pngs=("$tmp"/*.png)
    shopt -u nullglob
    if [[ ${#pngs[@]} -eq 1 ]]; then
      src="${pngs[0]}"
    fi
  fi
fi

if [[ -z "${src:-}" || ! -f "$src" ]]; then
  echo "error: Pico-8 did not write a ${ext} for $cart" >&2
  exit 1
fi

mkdir -p "$(dirname "$output")"
mv "$src" "$output"
echo "wrote $output"
