pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: sfx-speed
local t = 0
function _init()
  if stat(6)=="headless" then
    extcmd("set_filename", "sfx-speed")
    extcmd("audio_rec")
  end
  sfx(0)
end
function tick()
  t += 1
  if t == 12 then sfx(1) end
  if t == 36 then sfx(2) end
  if stat(6)=="headless" and t == 90 then
    extcmd("audio_end", 1)
    extcmd("shutdown")
  end
end
function _draw()
  cls(1)
  print("sfx-speed "..t, 4, 4, 7)
end
function _update() tick() end
function _update60() tick() end
__sfx__
