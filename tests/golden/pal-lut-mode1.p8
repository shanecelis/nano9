pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: mode 1 composes onto each earlier draw map
function _draw()
  cls(0)
  pal(8, 9)
  spr(0, 4, 8)
  sspr(0, 0, 8, 8, 20, 8)
  pal(8, 10)
  spr(0, 40, 8)
  sspr(0, 0, 8, 8, 56, 8)
  pal(9, 12, 1)
  if stat(6)=="headless" then
    extcmd("set_filename", "pal-lut-mode1")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
