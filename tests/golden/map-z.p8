pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: map z-order
--
-- screenshot is the second frame, after cls has hidden every map and
-- map() has drawn them again.
--
-- top: red rect, then a map, then a white rect over the second column.
-- red shows only through sprite 0. white covers that column.
--
-- bottom: three maps. the patterned map is first. pink covers its
-- second and third tiles. yellow covers the pink's left tile.
-- left to right that band is: blue hole, pink, yellow, sprite 3.
function _draw()
  frame = (frame or 0) + 1
  cls(1)
  rectfill(8, 8, 39, 23, 8)
  map(0, 0, 8, 8, 4, 2)
  rectfill(16, 8, 23, 23, 7)

  map(0, 0, 8, 40, 4, 1)
  map(0, 2, 16, 40, 2, 1)
  map(0, 3, 24, 40, 1, 1)
  if frame >= 2 and stat(6) == "headless" then
    extcmd("set_filename", "map-z")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
