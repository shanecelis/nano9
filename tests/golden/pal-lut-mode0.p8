pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: mode 0 keeps earlier spr/sspr mappings
function _draw()
  cls(0)
  pal(8, 12)
  spr(0, 8, 8)
  sspr(0, 0, 8, 8, 24, 8)
  pal(8, 11)
  spr(0, 48, 8)
  sspr(0, 0, 8, 8, 64, 8)
  if stat(6)=="headless" then
    extcmd("set_filename", "pal-lut-mode0")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
