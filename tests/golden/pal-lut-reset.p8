pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: pal(0), pal(1), pal(), and palt across a display remap
function _draw()
  cls(0)
  pal(8, 9)
  pal(9, 12, 1)
  spr(0, 4, 4)
  pal(0)
  spr(0, 20, 4)
  pal()
  palt(8, true)
  spr(0, 4, 24)
  pal(7, 11, 1)
  pal(1)
  spr(0, 20, 24)
  pal()
  spr(0, 36, 24)
  pal(8, 12, 1)
  if stat(6)=="headless" then
    extcmd("set_filename", "pal-lut-reset")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
