pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: pal / palt applied to spr, then reset
function _draw()
  cls(1)
  pal(8, 12)
  spr(0, 8, 8)
  palt(0, false)
  spr(2, 40, 8)
  pal()
  palt()
  spr(0, 8, 24)
  palt(0, false)
  spr(2, 40, 24)
  palt()
  if stat(6)=="headless" then
    extcmd("set_filename", "pal-spr")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
