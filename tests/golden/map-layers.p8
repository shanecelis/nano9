pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: map layers
--
-- sprite flags, in the same bit positions celeste passes to map():
--   1 red    bit 2 (4)  background
--   2 white  bit 1 (2)  terrain
--   3 blue   bit 3 (8)  foreground
--   4 green  bits 1 and 2 (6)
--   5 yellow no flags, so only the unfiltered map draws it
--   6 pink   bit 0 (1)
-- sprite 0 is red with every flag set, and map() still skips it.
function _draw()
  cls(1)
  -- every tile
  map(0, 0, 8, 4, 6, 4)
  -- same room, celeste's order: bg, terrain, fg
  map(0, 0, 8, 40, 6, 4, 4)
  map(0, 0, 8, 40, 6, 4, 2)
  map(0, 0, 8, 40, 6, 4, 8)
  -- each of those layers alone
  map(0, 0, 8, 76, 6, 4, 4)
  map(0, 0, 72, 4, 6, 4, 2)
  map(0, 0, 72, 40, 6, 4, 8)
  -- 6 is bits 1 and 2, so every sprite with either flag
  map(0, 0, 72, 76, 6, 4, 6)
  -- bit 0 alone
  map(0, 0, 72, 112, 6, 2, 1)
  -- title-style offset: two tiles hang off the left of the screen
  map(0, 0, -4, 112, 4, 2, 2)
  -- source cel is not the origin
  map(2, 2, 36, 112, 4, 2, 4)
  if stat(6) == "headless" then
    extcmd("set_filename", "map-layers")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
