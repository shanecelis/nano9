pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- probe: leftover oscillator across exports
-- all 64 slots are the same triangle scale (speed 8).
-- from the pico-8 prompt:
--   mkdir oscillator
--   cd oscillator
--   export osc%d.wav
--
-- osc0/1/2 already share a 155-sample (~7ms) lead-in but
-- the first peak walks ~20 samples earlier each slot.
-- a full bank lets us find the period, if any (osc0 == osc N).
function _draw()
  cls(1)
  print("oscillator probe", 4, 4, 7)
  print("64 identical sfx", 4, 12, 6)
  print("esc, then:", 4, 24, 6)
  print("  mkdir oscillator", 4, 32, 6)
  print("  cd oscillator", 4, 40, 6)
  print("  export osc%d.wav", 4, 48, 7)
end
