-- sfx 8: slide
-- sfx 9: vibrato
-- sfx 10: drop
-- sfx 11: fade-in
-- sfx 12: fade-out
-- sfx 13: arpeggio-fast
-- sfx 14: arpeggio-slow
function _init()
end
function _update()
end
function _draw()
  cls(1)
  print("synth goldens", 4, 4, 7)
  print("export synth%d.wav", 4, 12, 6)
end
